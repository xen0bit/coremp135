# Pinned upstream sources. Bump a line, rebuild, publish -> devices `apt upgrade`.
# To switch to ST's vendor trees, point *_REPO at github.com/STMicroelectronics/<proj>
# and *_REF at a *-stm32mp tag (e.g. v6.18-stm32mp-r1); board patches may need rebasing.

TFA_REPO=https://git.trustedfirmware.org/TF-A/trusted-firmware-a.git
TFA_REF=lts-v2.14.14

OPTEE_REPO=https://github.com/OP-TEE/optee_os.git
OPTEE_REF=4.11.0

UBOOT_REPO=https://source.denx.de/u-boot/u-boot.git
UBOOT_REF=v2026.10

LINUX_REPO=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
LINUX_REF=v6.18.63

# Debian userland
DEBIAN_SUITE=trixie
DEBIAN_MIRROR=http://deb.debian.org/debian

# Manual version bump for all our .debs (normally versions come from the git
# commit count of each package's inputs, see input_rev in scripts/common.sh)
PKG_REVISION="${PKG_REVISION:-1}"


# apt repository the image is configured to update from (empty = none).
# CI sets this to the GitHub Pages URL of the repo, e.g.
#   https://<owner>.github.io/<repo>
APT_REPO_URL="${APT_REPO_URL:-}"
APT_SUITE=trixie
