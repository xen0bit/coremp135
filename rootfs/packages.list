# Debian packages installed into the image (one per line, comments allowed).
# Add WiFi/BT firmware or tools here; they update with `apt upgrade`.

# base system
systemd-sysv
systemd-timesyncd
udev
dbus
# logind sessions for logins (SSH, console, the LCD kiosk); only a Recommends
# of systemd, which the image skips
libpam-systemd
kmod
sudo
# not Essential in trixie: agetty needs /bin/login for the serial consoles
login
# hwclock
util-linux-extra
locales
tzdata
less
nano
vim-tiny
bash-completion
htop
curl
ca-certificates
xz-utils
zstd

# storage / boot
e2fsprogs
dosfstools
fdisk
gdisk
cloud-guest-utils

# networking
iproute2
iputils-ping
# ping_group_range so unprivileged ping works (iputils-ping no longer uses setcap)
linux-sysctl-defaults
iw
ethtool
network-manager
wpasupplicant
openssh-server
avahi-daemon
libnss-mdns
nftables
wireless-regdb
rfkill

# board I/O tools
i2c-tools
can-utils
gpiod
alsa-utils
evtest
usbutils
bluez

# WiFi/Bluetooth firmware for common USB dongles (non-free-firmware)
firmware-realtek
firmware-misc-nonfree
firmware-mediatek
firmware-atheros
firmware-brcm80211

# runtime for the HDMI bridge blob
libstdc++6
