# --- buses the STM32MP135 doesn't have
# CONFIG_PCI is not set
# CONFIG_ATA is not set

# --- boot time
# Legacy BSD ptys add 512 device nodes (ttyp0.., ptyp0..) that udev and
# systemd process on every boot; everything uses /dev/pts (Unix98 ptys).
# CONFIG_LEGACY_PTYS is not set
# 16 RAM disks (/dev/ram*), unused: there is no initrd.
# CONFIG_BLK_DEV_RAM is not set
