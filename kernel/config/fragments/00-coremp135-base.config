# Core CoreMP135 support on top of multi_v7_defconfig.
# Anything here that does not end up in the final .config fails the build
# (see scripts/build-kernel.sh), so typos and missing dependencies are caught.

# --- Secure world / SCMI (OP-TEE provides clocks, resets, regulators, DVFS)
CONFIG_TEE=y
CONFIG_OPTEE=y
CONFIG_ARM_SCMI_PROTOCOL=y
CONFIG_ARM_SCMI_TRANSPORT_OPTEE=y
CONFIG_COMMON_CLK_SCMI=y
CONFIG_RESET_SCMI=y
CONFIG_REGULATOR_ARM_SCMI=y
CONFIG_CPU_FREQ=y
CONFIG_ARM_SCMI_CPUFREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# --- SoC peripherals
CONFIG_SERIAL_STM32=y
CONFIG_SERIAL_STM32_CONSOLE=y
CONFIG_I2C_STM32F7=y
CONFIG_I2C_CHARDEV=y
CONFIG_SPI_STM32=y
CONFIG_SPI_SPIDEV=m
CONFIG_MMC_ARMMMCI=y
CONFIG_MMC_STM32_SDMMC=y
CONFIG_STM32_WATCHDOG=y
CONFIG_STM32_THERMAL=y
CONFIG_CRYPTO_DEV_STM32_CRYP=m
CONFIG_PWM_STM32=m
CONFIG_STM32_ADC_CORE=m
CONFIG_STM32_ADC=m

# --- Ethernet: 2x DWMAC + RTL8211F
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_STM32=y
CONFIG_REALTEK_PHY=y
# MAC addresses live in the BSEC OTP; built in so Ethernet doesn't wait for modules
CONFIG_NVMEM_STM32_ROMEM=y

# --- CAN FD x2
CONFIG_CAN=m
CONFIG_CAN_M_CAN=m
CONFIG_CAN_M_CAN_PLATFORM=m

# --- Display: LTDC (HDMI bridge) + SPI LCD via panel-mipi-dbi
CONFIG_DRM=y
CONFIG_DRM_STM=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_PANEL_MIPI_DBI=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- AXP2101 PMU (board patches 0001-0003)
CONFIG_MFD_SIMPLE_MFD_I2C=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_AXP2101_POWEROFF=y
CONFIG_BACKLIGHT_AXP2101_M5STACK=y

# --- Touch, RTC
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
CONFIG_RTC_DRV_PCF8563=y

# --- Audio: SAI -> NS4168 amp / HDMI bridge
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_STM32_SAI=m
CONFIG_SND_SIMPLE_CARD=m
CONFIG_SND_SOC_SPDIF=m

# --- USB: EHCI/OHCI host (USB-A via hub), DWC2 gadget (USB-C)
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_PHY_STM32_USBPHYC=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_G_SERIAL=m
CONFIG_USB_STORAGE=y

# --- Debian/systemd userland expectations
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_AUTOFS_FS=y
CONFIG_FHANDLE=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_OVERLAY_FS=m
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_WIREGUARD=m
CONFIG_TUN=m
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m

# Stable release string (no -dirty from the patched git tree)
# CONFIG_LOCALVERSION_AUTO is not set

# Keep packages small
CONFIG_DEBUG_INFO_NONE=y
