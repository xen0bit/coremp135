#!/bin/sh
# Regenerate /boot/extlinux/extlinux.conf from installed kernels.
# U-Boot (distro boot / bootstd) reads this file from the rootfs partition.
set -eu

DTB=stm32mp135f-coremp135.dtb
CMDLINE="root=PARTLABEL=rootfs rootwait rw console=ttySTM0,115200"
OVERLAYS=""
MAX_KERNELS=3
MENU_TIMEOUT=10
[ -r /etc/default/coremp135 ] && . /etc/default/coremp135

BOOT=/boot
CONF="$BOOT/extlinux/extlinux.conf"
mkdir -p "$BOOT/extlinux" "$BOOT/dtbs"

# Newest first
versions=$(ls "$BOOT"/vmlinuz-* 2>/dev/null | sed 's|.*/vmlinuz-||' | sort -Vr | head -n "$MAX_KERNELS")
[ -n "$versions" ] || { echo "update-extlinux: no kernels in $BOOT" >&2; exit 0; }

# Copy DTBs/overlays next to the kernel so U-Boot only needs /boot
for v in $versions; do
	src=/usr/lib/linux-image-$v
	[ -d "$src" ] || continue
	mkdir -p "$BOOT/dtbs/$v"
	cp "$src/$DTB" "$BOOT/dtbs/$v/" 2>/dev/null || true
	cp "$src"/coremp135-*.dtbo "$BOOT/dtbs/$v/" 2>/dev/null || true
done
# Drop DTB dirs of kernels that are gone
for d in "$BOOT"/dtbs/*/; do
	v=$(basename "$d"); [ -e "$BOOT/vmlinuz-$v" ] || rm -rf "$d"
done

tmp=$(mktemp "$CONF.XXXXXX")
{
	echo "# Generated by update-extlinux — edit /etc/default/coremp135 instead"
	# A "menu" line makes U-Boot prompt; without it, it boots the default
	# right away. Only worth waiting when there is a fallback to pick.
	if [ "$(echo "$versions" | wc -l)" -gt 1 ] && [ "${MENU_TIMEOUT:-0}" -gt 0 ]; then
		echo "menu title M5Stack CoreMP135"
		echo "timeout $MENU_TIMEOUT"
	fi
	echo "default $(echo "$versions" | head -n1)"
	for v in $versions; do
		echo
		echo "label $v"
		echo "	menu label Debian GNU/Linux, kernel $v"
		echo "	kernel /boot/vmlinuz-$v"
		echo "	fdt /boot/dtbs/$v/$DTB"
		ovl=""
		for o in $OVERLAYS; do
			if [ -e "$BOOT/dtbs/$v/$o.dtbo" ]; then
				ovl="$ovl /boot/dtbs/$v/$o.dtbo"
			else
				echo "update-extlinux: warning: overlay $o not found for $v" >&2
			fi
		done
		[ -z "$ovl" ] || echo "	fdtoverlays$ovl"
		[ ! -e "$BOOT/initrd.img-$v" ] || echo "	initrd /boot/initrd.img-$v"
		echo "	append $CMDLINE"
	done
} > "$tmp"
chmod 644 "$tmp"
mv "$tmp" "$CONF"
sync
echo "update-extlinux: wrote $CONF ($(echo $versions | wc -w) kernel(s))"
