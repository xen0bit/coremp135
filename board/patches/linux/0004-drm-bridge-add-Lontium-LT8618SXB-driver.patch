From: CoreMP135 Debian build
Subject: [PATCH] drm/bridge: add Lontium LT8618SXB RGB to HDMI bridge driver

Drives the LT8618SXB on the M5Stack CoreMP135 (24-bit RGB with separate
syncs in, HDMI out), replacing M5Stack's userspace binary:
- the init sequence from M5Stack's MIT-licensed U-Boot driver
  (CoreMP135_buildroot-external-st, coremp135_5_15/patches/uboot/
  0005-lt8618sx.patch), with the TX PLL band chosen by pixel clock;
- EDID through the chip's DDC master and HPD polling, following Lontium's
  reference code as used in other GPL drivers for this chip;
- its own HDMI-A connector (or bridge .detect/.edid_read with
  DRM_BRIDGE_ATTACH_NO_CONNECTOR), AVI infoframe per mode, DVI sinks;
- modes limited to what the input pixel clock (the display controller's
  "lcd" clock on port 0) can produce.
---
diff --git a/drivers/gpu/drm/bridge/Kconfig b/drivers/gpu/drm/bridge/Kconfig
index a250afd8d..9f1ccf7bd 100644
--- a/drivers/gpu/drm/bridge/Kconfig
+++ b/drivers/gpu/drm/bridge/Kconfig
@@ -141,6 +141,15 @@ config DRM_LONTIUM_LT8912B
 	  Say M here if you want to support this hardware as a module.
 	  The module will be named "lontium-lt8912b".
 
+config DRM_LONTIUM_LT8618SXB
+	tristate "Lontium LT8618SXB RGB/HDMI bridge"
+	depends on OF && I2C
+	select DRM_KMS_HELPER
+	select HDMI
+	help
+	  Driver for the Lontium LT8618SXB parallel RGB to HDMI bridge,
+	  as used on the M5Stack CoreMP135.
+
 config DRM_LONTIUM_LT9211
 	tristate "Lontium LT9211 DSI/LVDS/DPI bridge"
 	depends on OF
diff --git a/drivers/gpu/drm/bridge/Makefile b/drivers/gpu/drm/bridge/Makefile
index c7dc03182..f09f1edf9 100644
--- a/drivers/gpu/drm/bridge/Makefile
+++ b/drivers/gpu/drm/bridge/Makefile
@@ -13,6 +13,7 @@ obj-$(CONFIG_DRM_I2C_NXP_TDA998X) += tda998x.o
 obj-$(CONFIG_DRM_ITE_IT6263) += ite-it6263.o
 obj-$(CONFIG_DRM_ITE_IT6505) += ite-it6505.o
 obj-$(CONFIG_DRM_LONTIUM_LT8912B) += lontium-lt8912b.o
+obj-$(CONFIG_DRM_LONTIUM_LT8618SXB) += lontium-lt8618sxb.o
 obj-$(CONFIG_DRM_LONTIUM_LT9211) += lontium-lt9211.o
 obj-$(CONFIG_DRM_LONTIUM_LT9611) += lontium-lt9611.o
 obj-$(CONFIG_DRM_LONTIUM_LT9611UXC) += lontium-lt9611uxc.o
diff --git a/drivers/gpu/drm/bridge/lontium-lt8618sxb.c b/drivers/gpu/drm/bridge/lontium-lt8618sxb.c
new file mode 100644
index 000000000..0a529c0c3
--- /dev/null
+++ b/drivers/gpu/drm/bridge/lontium-lt8618sxb.c
@@ -0,0 +1,637 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Lontium LT8618SXB parallel RGB to HDMI bridge.
+ *
+ * There is no public datasheet. The init sequence is the one M5Stack uses on
+ * the CoreMP135 (MIT, CoreMP135_buildroot-external-st,
+ * coremp135_5_15/patches/uboot/0005-lt8618sx.patch): 24-bit RGB input with
+ * separate syncs, 48 kHz I2S audio, HDMI output following the input timing.
+ * The chip measures the input timing itself; per mode we only pick the TX PLL
+ * band, the AVI infoframe (VIC, aspect) and HDMI vs DVI. EDID (DDC master),
+ * HPD and the TX PLL bands follow Lontium's reference code as used in other
+ * GPL drivers for this chip (e.g. D-Robotics' and Loongson's).
+ *
+ * The chip is reset by hardware (PMIC power-good) and needs no clocks or
+ * GPIOs from us. The input pixel clock must be running for its PLL to lock,
+ * so the sequence runs in atomic_enable, after the CRTC.
+ *
+ * Registers are 8-bit with a bank select in 0xff; a mutex keeps the bank
+ * consistent between HPD polling, EDID reads and modesets.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/hdmi.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_state_helper.h>
+#include <drm/drm_bridge.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_modeset_helper_vtables.h>
+#include <drm/drm_print.h>
+#include <drm/drm_probe_helper.h>
+
+#define LT8618_REG_BANK		0xff
+
+/* bank 0x82 */
+#define LT8618_LINK_STATUS	0x5e	/* bit 0: HPD */
+#define LT8618_TX_MODE		0xd6	/* bit 7: 1 = HDMI, 0 = DVI */
+/* bank 0x84: AVI infoframe PB0 (checksum) .. PB4 */
+#define LT8618_AVI_PB0		0x43
+/* bank 0x85: DDC master */
+#define LT8618_DDC_SPEED	0x02
+#define LT8618_DDC_CMD		0x07
+#define LT8618_DDC_STATUS	0x40
+#define LT8618_DDC_DONE		BIT(1)
+#define LT8618_DDC_NACK		BIT(4)
+#define LT8618_DDC_LOST		BIT(6)
+#define LT8618_DDC_FIFO		0x83
+#define LT8618_DDC_CHUNK	32
+
+/* Highest pixel clock of the TX PLL settings we know (HDMI 1.4). */
+#define LT8618_MAX_CLOCK_KHZ	165000
+/* Tolerance between a mode's clock and what the pixel clock can produce. */
+#define LT8618_CLOCK_TOL_HZ	50000
+
+struct lt8618sxb {
+	struct drm_bridge bridge;
+	struct drm_connector connector;
+	struct i2c_client *client;
+	struct clk *pixclk;	/* the input pixel clock, for mode filtering */
+	struct mutex lock;
+	bool sink_is_dvi;	/* EDID says DVI: no infoframes, no audio */
+	bool suspended;		/* the I2C bus may be down: don't touch the chip */
+	bool hpd;		/* last HPD state, reported while suspended */
+};
+
+static const u8 lt8618_init_input[] = {
+	0xff, 0x81, 0x30, 0x00, 0x02, 0x66, 0x0a, 0x06, 0x15, 0x06, 0x4e, 0xa8,
+	0xff, 0x82, 0x1b, 0x77, 0x1c, 0xec, 0xff, 0x80, 0xee, 0x01, 0x11, 0x00,
+	0x13, 0xf1, 0x13, 0xf9, 0x0a, 0x80, 0xff, 0x82, 0x45, 0x70, 0x4f, 0x40,
+	0x50, 0x00, 0x47, 0x07, 0xff, 0x82, 0xd6, 0x8e, 0xd7, 0x04, 0xff, 0x84,
+	0x06, 0x08, 0x07, 0x10, 0x09, 0x00, 0x0f, 0x2b, 0x34, 0xd5, 0x35, 0x00,
+	0x36, 0x18, 0x37, 0x00, 0x3c, 0x21, 0xff, 0x82, 0xde, 0x00, 0xde, 0xc0,
+	0xff, 0x81, 0x23, 0x40, 0x24, 0x64, 0x26, 0x55, 0x29, 0x04, 0x4d, 0x00,
+	0x27, 0x60, 0x28, 0x00, 0x25, 0x01, 0x2c, 0x94, 0x2d, 0x99,
+};
+
+/* bank 0x81; the 0x2d value depends on the pixel clock band (see below) */
+static const u8 lt8618_init_pll[] = {
+	0x25, 0x00, 0x2c, 0x9e, 0x2d, 0x99, 0x28, 0x88,
+	0x4d, 0x09, 0x27, 0x66, 0x2a, 0x00, 0x2a, 0x20,
+};
+
+static const u8 lt8618_pll_calibrate[] = {
+	0xff, 0x80, 0x16, 0xf1, 0x18, 0xdc, 0x18, 0xfc,
+	0x16, 0xf3, 0x16, 0xe3, 0x16, 0xf3, 0xff, 0x82,
+};
+
+static const u8 lt8618_init_output[] = {
+	0xb9, 0x00, 0xff, 0x84, 0x43, 0x31, 0x44, 0x10, 0x45, 0x2a, 0x47, 0x04,
+	0x10, 0x2c, 0x12, 0x64, 0x3d, 0x0a, 0xff, 0x80, 0x11, 0x00, 0x13, 0xf1,
+	0x13, 0xf9, 0xff, 0x81, 0x30, 0xea, 0x31, 0x44, 0x32, 0x4a, 0x33, 0x0b,
+	0x34, 0x00, 0x35, 0x00, 0x36, 0x00, 0x37, 0x44, 0x3f, 0x0f, 0x40, 0xa0,
+	0x41, 0xa0, 0x42, 0xa0, 0x43, 0xa0, 0x44, 0x0a,
+};
+
+static inline struct lt8618sxb *bridge_to_lt8618(struct drm_bridge *bridge)
+{
+	return container_of(bridge, struct lt8618sxb, bridge);
+}
+
+static inline struct lt8618sxb *connector_to_lt8618(struct drm_connector *c)
+{
+	return container_of(c, struct lt8618sxb, connector);
+}
+
+static int lt8618_write(struct lt8618sxb *lt, u8 reg, u8 val)
+{
+	return i2c_smbus_write_byte_data(lt->client, reg, val);
+}
+
+static int lt8618_read(struct lt8618sxb *lt, u8 reg)
+{
+	return i2c_smbus_read_byte_data(lt->client, reg);
+}
+
+static int lt8618_bank(struct lt8618sxb *lt, u8 bank)
+{
+	return lt8618_write(lt, LT8618_REG_BANK, bank);
+}
+
+static int lt8618_write_table(struct lt8618sxb *lt, const u8 *t, size_t len)
+{
+	size_t i;
+	int ret;
+
+	for (i = 0; i + 1 < len; i += 2) {
+		ret = lt8618_write(lt, t[i], t[i + 1]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int lt8618_update_bits(struct lt8618sxb *lt, u8 reg, u8 mask, u8 val)
+{
+	int ret = lt8618_read(lt, reg);
+
+	if (ret < 0)
+		return ret;
+	return lt8618_write(lt, reg, (ret & ~mask) | val);
+}
+
+/* Select register bank 0x80 and enable register access. */
+static int lt8618_unlock(struct lt8618sxb *lt)
+{
+	return lt8618_bank(lt, 0x80) ?: lt8618_write(lt, 0xee, 0x01);
+}
+
+/* --- HPD and EDID (caller holds lt->lock) */
+
+static bool lt8618_hpd(struct lt8618sxb *lt)
+{
+	int val;
+
+	/* HPD polling can race with system suspend */
+	if (lt->suspended)
+		return lt->hpd;
+	if (lt8618_unlock(lt) || lt8618_bank(lt, 0x82))
+		return false;
+	val = lt8618_read(lt, LT8618_LINK_STATUS);
+	lt->hpd = val >= 0 && (val & BIT(0));
+	return lt->hpd;
+}
+
+static int lt8618_ddc_read(struct lt8618sxb *lt, u8 offset, u8 *buf)
+{
+	/* speed 100 kHz, ?, EDID address 0xa0, offset, length */
+	const u8 cfg[] = { 0x0a, 0xc9, 0xa0, offset, LT8618_DDC_CHUNK };
+	int i, ret, status = 0;
+
+	ret = lt8618_bank(lt, 0x85);
+	for (i = 0; !ret && i < ARRAY_SIZE(cfg); i++)
+		ret = lt8618_write(lt, LT8618_DDC_SPEED + i, cfg[i]);
+	/* reset, then start a burst read */
+	ret = ret ?: lt8618_write(lt, LT8618_DDC_CMD, 0x36);
+	ret = ret ?: lt8618_write(lt, LT8618_DDC_CMD, 0x34);
+	ret = ret ?: lt8618_write(lt, LT8618_DDC_CMD, 0x37);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < 20; i++) {
+		usleep_range(2000, 3000);
+		status = lt8618_read(lt, LT8618_DDC_STATUS);
+		if (status < 0)
+			return status;
+		if (status & (LT8618_DDC_NACK | LT8618_DDC_LOST))
+			return -EIO;
+		if (status & LT8618_DDC_DONE)
+			break;
+	}
+	if (!(status & LT8618_DDC_DONE))
+		return -ETIMEDOUT;
+
+	for (i = 0; i < LT8618_DDC_CHUNK; i++) {
+		ret = lt8618_read(lt, LT8618_DDC_FIFO);
+		if (ret < 0)
+			return ret;
+		buf[i] = ret;
+	}
+	return 0;
+}
+
+/* drm_edid_read_custom() callback. Blocks 0 and 1 (no E-DDC segments). */
+static int lt8618_read_edid_block(void *data, u8 *buf, unsigned int block,
+				  size_t len)
+{
+	struct lt8618sxb *lt = data;
+	unsigned int off;
+	int ret = 0;
+
+	if (block > 1 || len > EDID_LENGTH)
+		return -EINVAL;
+	for (off = 0; !ret && off < len; off += LT8618_DDC_CHUNK) {
+		u8 chunk[LT8618_DDC_CHUNK];
+
+		ret = lt8618_ddc_read(lt, block * EDID_LENGTH + off, chunk);
+		if (!ret)
+			memcpy(buf + off, chunk, min_t(size_t, LT8618_DDC_CHUNK, len - off));
+	}
+	return ret;
+}
+
+static const struct drm_edid *lt8618_edid_read(struct lt8618sxb *lt,
+					       struct drm_connector *connector)
+{
+	const struct drm_edid *drm_edid = NULL;
+
+	mutex_lock(&lt->lock);
+	if (!lt->suspended && lt8618_hpd(lt)) {
+		drm_edid = drm_edid_read_custom(connector, lt8618_read_edid_block, lt);
+		lt8618_bank(lt, 0x80);
+	}
+	mutex_unlock(&lt->lock);
+	return drm_edid;
+}
+
+/* --- modes */
+
+static enum drm_mode_status lt8618_check_mode(struct lt8618sxb *lt,
+					      const struct drm_display_mode *mode)
+{
+	long want = mode->clock * 1000L, got;
+
+	if (mode->flags & DRM_MODE_FLAG_INTERLACE)
+		return MODE_NO_INTERLACE;
+	if (mode->clock > LT8618_MAX_CLOCK_KHZ)
+		return MODE_CLOCK_HIGH;
+	if (lt->pixclk) {
+		/* Only modes the input pixel clock can actually produce. */
+		got = clk_round_rate(lt->pixclk, want);
+		if (got <= 0 || abs(got - want) > LT8618_CLOCK_TOL_HZ)
+			return MODE_CLOCK_RANGE;
+	}
+	return MODE_OK;
+}
+
+/*
+ * If the sink's preferred mode can't be produced, prefer 1280x720@60 (or
+ * the first usable mode) so the console and simple clients get a picture.
+ */
+static void lt8618_fix_preferred(struct lt8618sxb *lt,
+				 struct drm_connector *connector)
+{
+	struct drm_display_mode *mode, *fallback = NULL;
+	bool have_preferred = false;
+
+	list_for_each_entry(mode, &connector->probed_modes, head) {
+		bool ok = lt8618_check_mode(lt, mode) == MODE_OK;
+
+		if ((mode->type & DRM_MODE_TYPE_PREFERRED) && !ok)
+			mode->type &= ~DRM_MODE_TYPE_PREFERRED;
+		have_preferred |= ok && (mode->type & DRM_MODE_TYPE_PREFERRED);
+		if (ok && (!fallback || (mode->hdisplay == 1280 &&
+					 mode->vdisplay == 720 &&
+					 drm_mode_vrefresh(mode) == 60)))
+			fallback = mode;
+	}
+	if (!have_preferred && fallback)
+		fallback->type |= DRM_MODE_TYPE_PREFERRED;
+}
+
+static int lt8618_get_modes(struct drm_connector *connector)
+{
+	struct lt8618sxb *lt = connector_to_lt8618(connector);
+	const struct drm_edid *drm_edid = lt8618_edid_read(lt, connector);
+	struct drm_display_mode *mode;
+	int count;
+
+	drm_edid_connector_update(connector, drm_edid);
+	count = drm_edid_connector_add_modes(connector);
+	lt->sink_is_dvi = drm_edid && !connector->display_info.is_hdmi;
+	drm_edid_free(drm_edid);
+
+	if (!count) {
+		/* No EDID: offer 720p60, which every HDMI sink must accept. */
+		mode = drm_display_mode_from_cea_vic(connector->dev, 4);
+		if (mode) {
+			mode->type |= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+			drm_mode_probed_add(connector, mode);
+			count = 1;
+		}
+	}
+	lt8618_fix_preferred(lt, connector);
+	return count;
+}
+
+static enum drm_mode_status
+lt8618_connector_mode_valid(struct drm_connector *connector,
+			    const struct drm_display_mode *mode)
+{
+	return lt8618_check_mode(connector_to_lt8618(connector), mode);
+}
+
+static enum drm_connector_status
+lt8618_connector_detect(struct drm_connector *connector, bool force)
+{
+	struct lt8618sxb *lt = connector_to_lt8618(connector);
+	bool hpd;
+
+	mutex_lock(&lt->lock);
+	hpd = lt8618_hpd(lt);
+	if (!lt->suspended)
+		lt8618_bank(lt, 0x80);
+	mutex_unlock(&lt->lock);
+	return hpd ? connector_status_connected : connector_status_disconnected;
+}
+
+static const struct drm_connector_helper_funcs lt8618_connector_helpers = {
+	.get_modes = lt8618_get_modes,
+	.mode_valid = lt8618_connector_mode_valid,
+};
+
+static const struct drm_connector_funcs lt8618_connector_funcs = {
+	.detect = lt8618_connector_detect,
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = drm_connector_cleanup,
+	.reset = drm_atomic_helper_connector_reset,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+
+/* --- modeset (caller holds lt->lock) */
+
+static int lt8618_set_avi(struct lt8618sxb *lt, struct drm_connector *connector,
+			  const struct drm_display_mode *mode)
+{
+	struct hdmi_avi_infoframe frame;
+	u8 buf[HDMI_INFOFRAME_SIZE(AVI)];
+	/* packed: type, version, length, PB0 (checksum), PB1, ... */
+	u8 *pb = buf + HDMI_INFOFRAME_HEADER_SIZE - 1;
+	int i, ret;
+
+	ret = drm_hdmi_avi_infoframe_from_display_mode(&frame, connector, mode);
+	if (ret)
+		return ret;
+	ret = hdmi_avi_infoframe_pack(&frame, buf, sizeof(buf));
+	if (ret < 0)
+		return ret;
+	/*
+	 * The chip has a fixed AVI header (type 0x82, version 2, length 13).
+	 * Like Lontium's code we write PB0 (checksum) .. PB4; PB5 and later
+	 * (pixel repetition, bar info) must be 0, which they are for our modes.
+	 */
+	for (i = 5; i <= HDMI_AVI_INFOFRAME_SIZE; i++)
+		if (pb[i])
+			dev_warn(&lt->client->dev, "AVI PB%d=%#x not sent\n", i, pb[i]);
+	ret = lt8618_bank(lt, 0x84);
+	for (i = 0; !ret && i <= 4; i++)
+		ret = lt8618_write(lt, LT8618_AVI_PB0 + i, pb[i]);
+	return ret;
+}
+
+static int lt8618_setup(struct lt8618sxb *lt, struct drm_connector *connector,
+			const struct drm_display_mode *mode)
+{
+	struct device *dev = &lt->client->dev;
+	u8 pll[sizeof(lt8618_init_pll)];
+	int ret, i, r15, rea, reb;
+
+	/* TX PLL band by pixel clock (Lontium: <50, 50-100, >100 MHz) */
+	memcpy(pll, lt8618_init_pll, sizeof(pll));
+	pll[5] = mode->clock < 50000 ? 0xaa : mode->clock <= 100000 ? 0x99 : 0x88;
+
+	ret = lt8618_unlock(lt);
+	ret = ret ?: lt8618_write_table(lt, lt8618_init_input,
+					ARRAY_SIZE(lt8618_init_input));
+	/* still in bank 0x81 */
+	ret = ret ?: lt8618_update_bits(lt, 0x2b, 0x02, 0x00);
+	ret = ret ?: lt8618_update_bits(lt, 0x2e, 0x01, 0x00);
+	ret = ret ?: lt8618_write_table(lt, pll, sizeof(pll));
+	if (ret)
+		return ret;
+
+	for (i = 0; i < 5; i++) {
+		msleep(10);
+		ret = lt8618_write_table(lt, lt8618_pll_calibrate,
+					 ARRAY_SIZE(lt8618_pll_calibrate));
+		if (ret)
+			return ret;
+		/* bank 0x82: PLL lock status */
+		r15 = lt8618_read(lt, 0x15);
+		rea = lt8618_read(lt, 0xea);
+		reb = lt8618_read(lt, 0xeb);
+		if (r15 < 0 || rea < 0 || reb < 0)
+			return -EIO;
+		if ((r15 & 0x80) && (reb & 0x80) && rea != 0xff)
+			break;
+	}
+	if (i == 5) {
+		dev_warn(dev, "TX PLL did not lock (0x15=%02x 0xea=%02x 0xeb=%02x); is the pixel clock running?\n",
+			 r15, rea, reb);
+		return -ETIMEDOUT;
+	}
+
+	ret = lt8618_write_table(lt, lt8618_init_output,
+				 ARRAY_SIZE(lt8618_init_output));
+	if (!ret && !lt->sink_is_dvi)
+		ret = lt8618_set_avi(lt, connector, mode);
+	/* HDMI (infoframes, audio) or plain DVI */
+	ret = ret ?: lt8618_bank(lt, 0x82);
+	ret = ret ?: lt8618_write(lt, LT8618_TX_MODE, lt->sink_is_dvi ? 0x0e : 0x8e);
+	return ret ?: lt8618_bank(lt, 0x80);
+}
+
+static void lt8618_atomic_enable(struct drm_bridge *bridge,
+				 struct drm_atomic_state *state)
+{
+	struct lt8618sxb *lt = bridge_to_lt8618(bridge);
+	struct drm_connector *connector;
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	int ret;
+
+	connector = drm_atomic_get_new_connector_for_encoder(state, bridge->encoder);
+	if (!connector)
+		return;
+	conn_state = drm_atomic_get_new_connector_state(state, connector);
+	crtc_state = drm_atomic_get_new_crtc_state(state, conn_state->crtc);
+
+	mutex_lock(&lt->lock);
+	ret = lt8618_setup(lt, connector, &crtc_state->adjusted_mode);
+	mutex_unlock(&lt->lock);
+	if (ret)
+		dev_err(&lt->client->dev, "setup failed: %d\n", ret);
+	else
+		dev_dbg(&lt->client->dev, "%s " DRM_MODE_FMT "\n",
+			lt->sink_is_dvi ? "DVI" : "HDMI",
+			DRM_MODE_ARG(&crtc_state->adjusted_mode));
+}
+
+static void lt8618_atomic_disable(struct drm_bridge *bridge,
+				  struct drm_atomic_state *state)
+{
+	struct lt8618sxb *lt = bridge_to_lt8618(bridge);
+
+	/* HDMI TX output off */
+	mutex_lock(&lt->lock);
+	if (!lt8618_unlock(lt) && !lt8618_bank(lt, 0x81))
+		lt8618_write(lt, 0x30, 0x00);
+	lt8618_bank(lt, 0x80);
+	mutex_unlock(&lt->lock);
+}
+
+/* --- bridge */
+
+static int lt8618_attach(struct drm_bridge *bridge, struct drm_encoder *encoder,
+			 enum drm_bridge_attach_flags flags)
+{
+	struct lt8618sxb *lt = bridge_to_lt8618(bridge);
+	struct drm_connector *connector = &lt->connector;
+	int ret;
+
+	/* With a bridge connector, it uses our .detect/.edid_read. */
+	if (flags & DRM_BRIDGE_ATTACH_NO_CONNECTOR)
+		return 0;
+
+	connector->polled = DRM_CONNECTOR_POLL_CONNECT | DRM_CONNECTOR_POLL_DISCONNECT;
+	drm_connector_helper_add(connector, &lt8618_connector_helpers);
+	ret = drm_connector_init(bridge->dev, connector, &lt8618_connector_funcs,
+				 DRM_MODE_CONNECTOR_HDMIA);
+	if (ret)
+		return ret;
+	return drm_connector_attach_encoder(connector, encoder);
+}
+
+static enum drm_mode_status lt8618_bridge_mode_valid(struct drm_bridge *bridge,
+						     const struct drm_display_info *info,
+						     const struct drm_display_mode *mode)
+{
+	return lt8618_check_mode(bridge_to_lt8618(bridge), mode);
+}
+
+static enum drm_connector_status lt8618_bridge_detect(struct drm_bridge *bridge,
+						      struct drm_connector *connector)
+{
+	return lt8618_connector_detect(&bridge_to_lt8618(bridge)->connector, false);
+}
+
+static const struct drm_edid *lt8618_bridge_edid_read(struct drm_bridge *bridge,
+						      struct drm_connector *connector)
+{
+	return lt8618_edid_read(bridge_to_lt8618(bridge), connector);
+}
+
+static const struct drm_bridge_timings lt8618_timings = {
+	/* matches the chip setup: 0x824f = 0x40 (dclk inverted) */
+	.input_bus_flags = DRM_BUS_FLAG_DE_HIGH | DRM_BUS_FLAG_PIXDATA_DRIVE_POSEDGE,
+};
+
+static const struct drm_bridge_funcs lt8618_funcs = {
+	.attach = lt8618_attach,
+	.mode_valid = lt8618_bridge_mode_valid,
+	.atomic_enable = lt8618_atomic_enable,
+	.atomic_disable = lt8618_atomic_disable,
+	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
+	.atomic_reset = drm_atomic_helper_bridge_reset,
+	.detect = lt8618_bridge_detect,
+	.edid_read = lt8618_bridge_edid_read,
+};
+
+/* The pixel clock of the display controller on our input port, if any. */
+static struct clk *lt8618_get_pixclk(struct device *dev)
+{
+	struct device_node *src = of_graph_get_remote_node(dev->of_node, 0, -1);
+	struct clk *clk;
+
+	if (!src)
+		return NULL;
+	clk = of_clk_get_by_name(src, "lcd");
+	of_node_put(src);
+	if (IS_ERR(clk)) {
+		dev_info(dev, "no input pixel clock to check modes against\n");
+		return NULL;
+	}
+	return clk;
+}
+
+static int lt8618_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct lt8618sxb *lt;
+	int id[3], i, ret;
+
+	lt = devm_drm_bridge_alloc(dev, struct lt8618sxb, bridge, &lt8618_funcs);
+	if (IS_ERR(lt))
+		return PTR_ERR(lt);
+	lt->client = client;
+	ret = devm_mutex_init(dev, &lt->lock);
+	if (ret)
+		return ret;
+
+	ret = lt8618_unlock(lt);
+	if (ret)
+		return dev_err_probe(dev, ret, "no response\n");
+	for (i = 0; i < 3; i++) {
+		id[i] = lt8618_read(lt, i);
+		if (id[i] < 0)
+			return dev_err_probe(dev, id[i], "cannot read chip ID\n");
+	}
+	if (id[0] != 0x17 || id[1] != 0x02)
+		return dev_err_probe(dev, -ENODEV, "unknown chip ID %02x %02x %02x\n",
+				     id[0], id[1], id[2]);
+	dev_info(dev, "LT8618SXB chip ID %02x %02x %02x\n", id[0], id[1], id[2]);
+
+	lt->pixclk = lt8618_get_pixclk(dev);
+	i2c_set_clientdata(client, lt);
+	lt->bridge.of_node = dev->of_node;
+	lt->bridge.type = DRM_MODE_CONNECTOR_HDMIA;
+	lt->bridge.ops = DRM_BRIDGE_OP_DETECT | DRM_BRIDGE_OP_EDID;
+	lt->bridge.timings = &lt8618_timings;
+	return devm_drm_bridge_add(dev, &lt->bridge);
+}
+
+static int lt8618_suspend(struct device *dev)
+{
+	struct lt8618sxb *lt = dev_get_drvdata(dev);
+
+	mutex_lock(&lt->lock);
+	lt->suspended = true;
+	mutex_unlock(&lt->lock);
+	return 0;
+}
+
+static int lt8618_resume(struct device *dev)
+{
+	struct lt8618sxb *lt = dev_get_drvdata(dev);
+
+	mutex_lock(&lt->lock);
+	lt->suspended = false;
+	mutex_unlock(&lt->lock);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(lt8618_pm_ops, lt8618_suspend, lt8618_resume);
+
+static void lt8618_remove(struct i2c_client *client)
+{
+	struct lt8618sxb *lt = i2c_get_clientdata(client);
+
+	clk_put(lt->pixclk);
+}
+
+static const struct i2c_device_id lt8618_id[] = {
+	{ "lt8618sxb" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, lt8618_id);
+
+static const struct of_device_id lt8618_of_match[] = {
+	{ .compatible = "lontium,lt8618sxb" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, lt8618_of_match);
+
+static struct i2c_driver lt8618_driver = {
+	.probe = lt8618_probe,
+	.remove = lt8618_remove,
+	.id_table = lt8618_id,
+	.driver = {
+		.name = "lt8618sxb",
+		.of_match_table = lt8618_of_match,
+		.pm = pm_sleep_ptr(&lt8618_pm_ops),
+	},
+};
+module_i2c_driver(lt8618_driver);
+
+MODULE_DESCRIPTION("Lontium LT8618SXB RGB to HDMI bridge");
+MODULE_LICENSE("GPL");
