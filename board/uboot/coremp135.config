# Applied on top of upstream configs/stm32mp13_defconfig
CONFIG_DEFAULT_DEVICE_TREE="st/stm32mp135f-coremp135"
# Only build our board DT, not every ST DT
# CONFIG_OF_UPSTREAM_BUILD_VENDOR is not set
CONFIG_SYS_PROMPT="CoreMP135> "
# No autoboot countdown: holding a key on the console at power-on still
# stops autoboot (bootdelay 0 checks once), and extlinux shows a menu when
# there is a fallback kernel.
CONFIG_BOOTDELAY=0
# Ethernet in U-Boot (TFTP/netboot); RTL8211F PHYs
CONFIG_DWC_ETH_QOS=y
CONFIG_DWC_ETH_QOS_STM32=y
CONFIG_PHY_REALTEK=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
# Not present on this board
# CONFIG_LED_BOOT is not set
