// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
/*
 * M5Stack CoreMP135 (K135)
 *
 * Mainline-style board DT, also used by U-Boot (copied into
 * dts/upstream/src/arm/st/ at build time).
 *
 * Derived from upstream stm32mp135f-dk.dts (STMicroelectronics) and the
 * vendor DTS in github.com/m5stack/CoreMP135_buildroot-external-st.
 *
 * Power: an AXP2101 PMU powers up the SoC rails with fixed defaults, so the
 * rails are modelled as fixed regulators. Linux uses the AXP2101 only for
 * poweroff and the LCD backlight (DLDO1).
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/regulator/st,stm32mp13-regulator.h>
#include "stm32mp135.dtsi"
#include "stm32mp13xf.dtsi"
#include "stm32mp13-pinctrl.dtsi"

/ {
	model = "M5Stack CoreMP135";
	compatible = "m5stack,coremp135", "st,stm32mp135";

	aliases {
		ethernet0 = &ethernet1;
		ethernet1 = &ethernet2;
		serial0 = &usart6;	/* PORT.C (Grove) — system console */
		serial1 = &usart1;	/* M5-Bus */
		serial2 = &usart2;	/* M5-Bus */
		serial3 = &usart3;	/* RS485 (PWR485 connector) */
		i2c0 = &i2c3;		/* internal: AXP2101, touch, RTC, HDMI bridge */
		i2c1 = &i2c5;		/* PORT.A (Grove) */
		i2c2 = &i2c1;		/* M5-Bus */
		i2c3 = &i2c2;		/* M5-Bus */
		rtc0 = &bm8563;
		mmc0 = &sdmmc1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@c0000000 {
		device_type = "memory";
		reg = <0xc0000000 0x20000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		optee@dd000000 {
			reg = <0xdd000000 0x3000000>;
			no-map;
		};
	};

	v3v3: regulator-v3v3 {
		compatible = "regulator-fixed";
		regulator-name = "v3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * HDMI: LTDC parallel RGB -> Lontium LT8618SXB. There is no mainline
	 * driver for the bridge yet; it is set up from userspace
	 * (coremp135-hdmi package). The LTDC drives a fixed 720p timing.
	 */
	panel-hdmi {
		compatible = "panel-dpi";
		power-supply = <&v3v3>;
		data-mapping = "rgb24";
		width-mm = <320>;
		height-mm = <180>;

		panel-timing {
			clock-frequency = <74250000>;
			hactive = <1280>;
			vactive = <720>;
			hsync-len = <40>;
			hfront-porch = <110>;
			hback-porch = <220>;
			vsync-len = <5>;
			vfront-porch = <5>;
			vback-porch = <20>;
			hsync-active = <1>;
			vsync-active = <1>;
			de-active = <1>;
			pixelclk-active = <1>;
		};

		port {
			panel_in_rgb: endpoint {
				remote-endpoint = <&ltdc_out_rgb>;
			};
		};
	};

	/* NS4168 mono class-D amp on SAI1A (no control interface) */
	sound-speaker {
		compatible = "simple-audio-card";
		simple-audio-card,name = "CoreMP135-Speaker";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;

		simple-audio-card,cpu {
			sound-dai = <&sai1a>;
		};

		simple-audio-card,codec {
			sound-dai = <&codec_speaker>;
		};
	};

	/* I2S audio into the LT8618SXB HDMI bridge on SAI1B */
	sound-hdmi {
		compatible = "simple-audio-card";
		simple-audio-card,name = "CoreMP135-HDMI";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;

		simple-audio-card,cpu {
			sound-dai = <&sai1b>;
		};

		simple-audio-card,codec {
			sound-dai = <&codec_hdmi>;
		};
	};

	codec_speaker: audio-codec-speaker {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
	};

	codec_hdmi: audio-codec-hdmi {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
	};
};

&crc1 {
	status = "okay";
};

&cryp {
	status = "okay";
};

&dts {
	status = "okay";
};

&ethernet1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&eth1_pins_coremp135>;
	pinctrl-1 = <&eth1_sleep_pins_coremp135>;
	phy-mode = "rgmii-id";
	max-speed = <1000>;
	phy-handle = <&ethphy1>;
	nvmem-cells = <&ethernet_mac1_address>;
	nvmem-cell-names = "mac-address";
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";

		ethphy1: ethernet-phy@0 {
			/* RTL8211F; supplies the 125 MHz reference on ETH1_CLK125 */
			compatible = "ethernet-phy-id001c.c916";
			reg = <0>;
			reset-gpios = <&gpioa 10 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <30000>;
		};
	};
};

&ethernet2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&eth2_pins_coremp135>;
	pinctrl-1 = <&eth2_sleep_pins_coremp135>;
	phy-mode = "rgmii-id";
	max-speed = <1000>;
	phy-handle = <&ethphy2>;
	nvmem-cells = <&ethernet_mac2_address>;
	nvmem-cell-names = "mac-address";
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";

		ethphy2: ethernet-phy@0 {
			compatible = "ethernet-phy-id001c.c916";
			reg = <0>;
			reset-gpios = <&gpioa 14 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <30000>;
		};
	};
};

&gpioi {
	/* 5 V direction on the M5-Bus: high = CoreMP135 supplies 5 V to the bus */
	bus-out-en-hog {
		gpio-hog;
		gpios = <3 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "BUS_OUT_EN";
	};
};

/* M5-Bus I2C */
&i2c1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c1_pins_coremp135>;
	pinctrl-1 = <&i2c1_sleep_pins_coremp135>;
	clock-frequency = <100000>;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
};

/* M5-Bus I2C */
&i2c2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c2_pins_coremp135>;
	pinctrl-1 = <&i2c2_sleep_pins_coremp135>;
	clock-frequency = <100000>;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
};

/* Internal I2C */
&i2c3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c3_pins_coremp135>;
	pinctrl-1 = <&i2c3_sleep_pins_coremp135>;
	clock-frequency = <100000>;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";

	pmic@34 {
		compatible = "x-powers,axp2101";
		reg = <0x34>;

		backlight: backlight {
			compatible = "m5stack,axp2101-backlight";
		};

		poweroff {
			compatible = "x-powers,axp2101-poweroff";
		};
	};

	touchscreen@38 {
		compatible = "focaltech,ft6236";
		reg = <0x38>;
		interrupt-parent = <&gpioi>;
		interrupts = <1 IRQ_TYPE_EDGE_FALLING>;
		touchscreen-size-x = <320>;
		touchscreen-size-y = <240>;
	};

	bm8563: rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
	};
};

/* PORT.A (Grove) I2C */
&i2c5 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c5_pins_coremp135>;
	pinctrl-1 = <&i2c5_sleep_pins_coremp135>;
	clock-frequency = <100000>;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
};

&iwdg2 {
	timeout-sec = <32>;
	status = "okay";
};

&ltdc {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&ltdc_pins_coremp135>;
	pinctrl-1 = <&ltdc_sleep_pins_coremp135>;
	status = "okay";

	port {
		ltdc_out_rgb: endpoint {
			remote-endpoint = <&panel_in_rgb>;
		};
	};
};

&m_can1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&fdcan1_pins_coremp135>;
	pinctrl-1 = <&fdcan1_sleep_pins_coremp135>;
	status = "okay";
};

&m_can2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&fdcan2_pins_coremp135>;
	pinctrl-1 = <&fdcan2_sleep_pins_coremp135>;
	status = "okay";
};

/* SoC RTC is left to the secure world; the battery-backed BM8563 is rtc0. */
&rtc {
	status = "disabled";
};

&sai1 {
	clocks = <&rcc SAI1>, <&scmi_clk CK_SCMI_PLL3_Q>, <&scmi_clk CK_SCMI_PLL3_R>;
	clock-names = "pclk", "x8k", "x11k";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sai1a_pins_coremp135>, <&sai1b_pins_coremp135>;
	pinctrl-1 = <&sai1a_sleep_pins_coremp135>, <&sai1b_sleep_pins_coremp135>;
	status = "okay";
};

&sai1a {
	dma-names = "tx";
	#clock-cells = <0>;
	status = "okay";
};

&sai1b {
	dma-names = "tx";
	#clock-cells = <0>;
	status = "okay";
};

&sdmmc1 {
	pinctrl-names = "default", "opendrain", "sleep";
	pinctrl-0 = <&sdmmc1_b4_pins_a &sdmmc1_clk_pins_a>;
	pinctrl-1 = <&sdmmc1_b4_od_pins_a &sdmmc1_clk_pins_a>;
	pinctrl-2 = <&sdmmc1_b4_sleep_pins_a>;
	broken-cd;	/* no card-detect line */
	disable-wp;
	st,neg-edge;
	bus-width = <4>;
	vmmc-supply = <&v3v3>;
	status = "okay";
};

/* Built-in 2" 320x240 ILI9342C LCD */
&spi1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&spi1_pins_coremp135>;
	pinctrl-1 = <&spi1_sleep_pins_coremp135>;
	cs-gpios = <&gpioh 5 GPIO_ACTIVE_LOW>;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";

	display@0 {
		/* Init sequence: /lib/firmware/m5stack,coremp135-panel.bin */
		compatible = "m5stack,coremp135-panel", "panel-mipi-dbi-spi";
		reg = <0>;
		spi-max-frequency = <40000000>;
		dc-gpios = <&gpioh 4 GPIO_ACTIVE_HIGH>;
		/* mipi_dbi drives reset to logical 1 to run the panel, so the
		 * (physically active-low) line is described as active high,
		 * like in the panel-mipi-dbi-spi binding example. */
		reset-gpios = <&gpioi 0 GPIO_ACTIVE_HIGH>;
		write-only;
		backlight = <&backlight>;
		width-mm = <41>;
		height-mm = <31>;

		panel-timing {
			hactive = <320>;
			vactive = <240>;
			hback-porch = <0>;
			vback-porch = <0>;
			clock-frequency = <0>;
			hfront-porch = <0>;
			hsync-len = <0>;
			vfront-porch = <0>;
			vsync-len = <0>;
		};
	};
};

/* M5-Bus SPI (enable with the coremp135-mbus-spidev overlay) */
&spi4 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&spi4_pins_coremp135>;
	pinctrl-1 = <&spi4_sleep_pins_coremp135>;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "disabled";
};

/* M5-Bus UART (disabled; enable with an overlay) */
&usart1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&usart1_pins_coremp135>;
	pinctrl-1 = <&usart1_sleep_pins_coremp135>;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "disabled";
};

/* M5-Bus UART (disabled; enable with the coremp135-mbus-uart2 overlay) */
&usart2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&usart2_pins_coremp135>;
	pinctrl-1 = <&usart2_sleep_pins_coremp135>;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "disabled";
};

/* RS485 via MAX3485, driver-enable on USART3_DE (PD12) */
&usart3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&usart3_pins_coremp135>;
	pinctrl-1 = <&usart3_sleep_pins_coremp135>;
	/delete-property/dmas;
	/delete-property/dma-names;
	linux,rs485-enabled-at-boot-time;
	status = "okay";
};

/* PORT.C (Grove) — console */
&usart6 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&usart6_pins_coremp135>;
	pinctrl-1 = <&usart6_sleep_pins_coremp135>;
	/delete-property/dmas;
	/delete-property/dma-names;
	rx-tx-swap;	/* as in M5Stack's vendor DT */
	status = "okay";
};

/* USB-A x2 behind the GL852G hub */
&usbh_ehci {
	phys = <&usbphyc_port0>;
	status = "okay";
};

&usbh_ohci {
	phys = <&usbphyc_port0>;
	status = "okay";
};

/* USB-C: device mode (USB gadget, e.g. serial console / ethernet) */
&usbotg_hs {
	dr_mode = "peripheral";
	phys = <&usbphyc_port1 0>;
	phy-names = "usb2-phy";
	status = "okay";
};

&usbphyc {
	status = "okay";
};

&usbphyc_port0 {
	phy-supply = <&v3v3>;
	st,current-boost-microamp = <1000>;
	st,decrease-hs-slew-rate;
	st,tune-hs-dc-level = <2>;
	st,enable-hs-rftime-reduction;
	st,trim-hs-current = <11>;
	st,trim-hs-impedance = <2>;
	st,tune-squelch-level = <1>;
	st,enable-hs-rx-gain-eq;
	st,no-hs-ftime-ctrl;
	st,no-lsfs-sc;
};

&usbphyc_port1 {
	phy-supply = <&v3v3>;
	st,current-boost-microamp = <1000>;
	st,decrease-hs-slew-rate;
	st,tune-hs-dc-level = <2>;
	st,enable-hs-rftime-reduction;
	st,trim-hs-current = <11>;
	st,trim-hs-impedance = <2>;
	st,tune-squelch-level = <1>;
	st,enable-hs-rx-gain-eq;
	st,no-hs-ftime-ctrl;
	st,no-lsfs-sc;
};

/* Board pin groups (from M5Stack's CubeMX-generated vendor DT) */
&pinctrl {
	eth1_pins_coremp135: eth1-coremp135-0 {
		pins1 {
			pinmux = <STM32_PINMUX('A', 2, AF11)>; /* ETH1_MDIO */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
		pins2 {
			pinmux = <STM32_PINMUX('A', 7, AF11)>, /* ETH1_RX_CTL */
					 <STM32_PINMUX('B', 0, AF11)>, /* ETH1_RXD2 */
					 <STM32_PINMUX('B', 1, AF11)>, /* ETH1_RXD3 */
					 <STM32_PINMUX('C', 4, AF11)>, /* ETH1_RXD0 */
					 <STM32_PINMUX('C', 5, AF11)>, /* ETH1_RXD1 */
					 <STM32_PINMUX('D', 7, AF10)>; /* ETH1_RX_CLK */
			bias-disable;
		};
		pins3 {
			pinmux = <STM32_PINMUX('B', 11, AF11)>, /* ETH1_TX_CTL */
					 <STM32_PINMUX('C', 1, AF11)>, /* ETH1_GTX_CLK */
					 <STM32_PINMUX('C', 2, AF11)>, /* ETH1_TXD2 */
					 <STM32_PINMUX('E', 5, AF10)>, /* ETH1_TXD3 */
					 <STM32_PINMUX('G', 2, AF11)>, /* ETH1_MDC */
					 <STM32_PINMUX('F', 12, AF11)>, /* ETH1_CLK125 */
					 <STM32_PINMUX('G', 13, AF11)>, /* ETH1_TXD0 */
					 <STM32_PINMUX('G', 14, AF11)>; /* ETH1_TXD1 */
			bias-disable;
			drive-push-pull;
			slew-rate = <2>;
		};
	};

	eth1_sleep_pins_coremp135: eth1-sleep-coremp135-0 {
		pins {
			pinmux = <STM32_PINMUX('A', 2, ANALOG)>, /* ETH1_MDIO */
					 <STM32_PINMUX('A', 7, ANALOG)>, /* ETH1_RX_CTL */
					 <STM32_PINMUX('B', 0, ANALOG)>, /* ETH1_RXD2 */
					 <STM32_PINMUX('B', 1, ANALOG)>, /* ETH1_RXD3 */
					 <STM32_PINMUX('B', 11, ANALOG)>, /* ETH1_TX_CTL */
					 <STM32_PINMUX('C', 1, ANALOG)>, /* ETH1_GTX_CLK */
					 <STM32_PINMUX('C', 2, ANALOG)>, /* ETH1_TXD2 */
					 <STM32_PINMUX('C', 4, ANALOG)>, /* ETH1_RXD0 */
					 <STM32_PINMUX('C', 5, ANALOG)>, /* ETH1_RXD1 */
					 <STM32_PINMUX('D', 7, ANALOG)>, /* ETH1_RX_CLK */
					 <STM32_PINMUX('E', 5, ANALOG)>, /* ETH1_TXD3 */
					 <STM32_PINMUX('G', 2, ANALOG)>, /* ETH1_MDC */
					 <STM32_PINMUX('F', 12, ANALOG)>, /* ETH1_CLK125 */
					 <STM32_PINMUX('G', 13, ANALOG)>, /* ETH1_TXD0 */
					 <STM32_PINMUX('G', 14, ANALOG)>; /* ETH1_TXD1 */
		};
	};

	eth2_pins_coremp135: eth2-coremp135-0 {
		pins1 {
			pinmux = <STM32_PINMUX('A', 8, AF11)>, /* ETH2_RXD3 */
					 <STM32_PINMUX('E', 2, AF10)>, /* ETH2_RXD1 */
					 <STM32_PINMUX('F', 4, AF11)>, /* ETH2_RXD0 */
					 <STM32_PINMUX('G', 12, AF12)>, /* ETH2_RX_CTL */
					 <STM32_PINMUX('H', 6, AF12)>, /* ETH2_RXD2 */
					 <STM32_PINMUX('H', 11, AF11)>; /* ETH2_RX_CLK */
			bias-disable;
		};
		pins2 {
			pinmux = <STM32_PINMUX('B', 2, AF11)>; /* ETH2_MDIO */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
		pins3 {
			pinmux = <STM32_PINMUX('E', 6, AF11)>, /* ETH2_TXD3 */
					 <STM32_PINMUX('F', 6, AF11)>, /* ETH2_TX_CTL */
					 <STM32_PINMUX('F', 7, AF11)>, /* ETH2_TXD0 */
					 <STM32_PINMUX('G', 1, AF10)>, /* ETH2_TXD2 */
					 <STM32_PINMUX('G', 3, AF10)>, /* ETH2_GTX_CLK */
					 <STM32_PINMUX('G', 5, AF10)>, /* ETH2_MDC */
					 <STM32_PINMUX('G', 11, AF10)>, /* ETH2_TXD1 */
					 <STM32_PINMUX('H', 2, AF13)>; /* ETH2_CLK125 */
			bias-disable;
			drive-push-pull;
			slew-rate = <2>;
		};
	};

	eth2_sleep_pins_coremp135: eth2-sleep-coremp135-0 {
		pins {
			pinmux = <STM32_PINMUX('A', 8, ANALOG)>, /* ETH2_RXD3 */
					 <STM32_PINMUX('B', 2, ANALOG)>, /* ETH2_MDIO */
					 <STM32_PINMUX('E', 2, ANALOG)>, /* ETH2_RXD1 */
					 <STM32_PINMUX('E', 6, ANALOG)>, /* ETH2_TXD3 */
					 <STM32_PINMUX('F', 4, ANALOG)>, /* ETH2_RXD0 */
					 <STM32_PINMUX('F', 6, ANALOG)>, /* ETH2_TX_CTL */
					 <STM32_PINMUX('F', 7, ANALOG)>, /* ETH2_TXD0 */
					 <STM32_PINMUX('G', 1, ANALOG)>, /* ETH2_TXD2 */
					 <STM32_PINMUX('G', 3, ANALOG)>, /* ETH2_GTX_CLK */
					 <STM32_PINMUX('G', 5, ANALOG)>, /* ETH2_MDC */
					 <STM32_PINMUX('H', 2, ANALOG)>, /* ETH2_CLK125 */
					 <STM32_PINMUX('G', 11, ANALOG)>, /* ETH2_TXD1 */
					 <STM32_PINMUX('G', 12, ANALOG)>, /* ETH2_RX_CTL */
					 <STM32_PINMUX('H', 6, ANALOG)>, /* ETH2_RXD2 */
					 <STM32_PINMUX('H', 11, ANALOG)>; /* ETH2_RX_CLK */
		};
	};

	fdcan1_pins_coremp135: fdcan1-coremp135-0 {
		pins1 {
			pinmux = <STM32_PINMUX('E', 10, AF9)>; /* FDCAN1_TX */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
		pins2 {
			pinmux = <STM32_PINMUX('E', 3, AF9)>; /* FDCAN1_RX */
			bias-disable;
		};
	};

	fdcan1_sleep_pins_coremp135: fdcan1-sleep-coremp135-0 {
		pins {
			pinmux = <STM32_PINMUX('E', 3, ANALOG)>, /* FDCAN1_RX */
					 <STM32_PINMUX('E', 10, ANALOG)>; /* FDCAN1_TX */
		};
	};

	fdcan2_pins_coremp135: fdcan2-coremp135-0 {
		pins1 {
			pinmux = <STM32_PINMUX('E', 0, AF9)>; /* FDCAN2_RX */
			bias-disable;
		};
		pins2 {
			pinmux = <STM32_PINMUX('G', 0, AF9)>; /* FDCAN2_TX */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};

	fdcan2_sleep_pins_coremp135: fdcan2-sleep-coremp135-0 {
		pins {
			pinmux = <STM32_PINMUX('E', 0, ANALOG)>, /* FDCAN2_RX */
